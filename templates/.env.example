# Copiar como .env en la carpeta del proyecto (Paso 1).
# Cargar en cada shell nueva: set -a && source .env && set +a

# Tienda (dominio .myshopify.com)
SHOPIFY_STORE=

# Las 3 URLs de MÁS tráfico según Analytics
HOME_URL=
PDP_URL=
COLLECTION_URL=

# API key de CrUX (Chrome UX Report)
CRUX_API_KEY=

# ID del tema duplicado "[CM] Perf AAAAMM" — se llena en el Paso 2
WORK_THEME_ID=
