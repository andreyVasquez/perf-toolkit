# .env del proyecto (lo crea scripts/new-project.mjs; NUNCA se commitea)
SHOPIFY_STORE=marca.myshopify.com

# Las 3 páginas de MÁS tráfico según Analytics
HOME_URL=https://www.marca.com/
PDP_URL=https://www.marca.com/products/best-seller
COLLECTION_URL=https://www.marca.com/collections/top

# Se copian del .env del toolkit si existen
CRUX_API_KEY=
TINYPNG_API_KEY=

# Duplicado despublicado "[CM] Perf AAAAMM" (lo escribe new-project.mjs, Paso 2)
WORK_THEME_ID=

# Opcional: dominio propio de GTM server-side / Stape para pixel-check (separados por coma)
# SGTM_HOST=gtm.marca.com
# Opcional: Chrome no estándar para pixel-check / net-check / screenshot-diff
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
