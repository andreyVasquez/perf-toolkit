{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resultados.schema.json",
  "title": "Resultados v1",
  "description": "Mediciones post-publicación (Paso 7). Misma forma que baseline.schema.json: un array de mediciones.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "marca",
      "fecha",
      "url",
      "pagina",
      "metrica",
      "valor",
      "unidad",
      "fuente",
      "metodologia_version"
    ],
    "properties": {
      "marca": { "type": "string" },
      "fecha": { "type": "string", "format": "date" },
      "url": { "type": "string", "format": "uri" },
      "pagina": { "enum": ["home", "pdp", "collection"] },
      "metrica": { "type": "string" },
      "valor": { "type": "number" },
      "unidad": { "type": "string" },
      "fuente": { "enum": ["crux-page", "crux-origin", "shopify-rum", "lab"] },
      "metodologia_version": { "type": "string" }
    }
  }
}
